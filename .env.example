# Davnoot — environment variables TEMPLATE.
#
# ⚠  THIS FILE IS COMMITTED TO GIT. It is a template, not a config file.
#     Never put a real password, API secret, or connection string in here —
#     it will end up on GitHub. Real values go in .env.local, which is gitignored.
#
# Setup:
#   cp .env.example .env.local     then fill .env.local in
#   and set the same keys in Vercel → Settings → Environment Variables.

# ---- Database --------------------------------------------------------------
# MongoDB Atlas connection string. Include the database name or set MONGODB_DB.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="davnoot"

# ---- Writer dashboard auth (/seoteam) --------------------------------------
# The shared password the content team types in. Rotate by changing this value.
SEOTEAM_PASSWORD="choose-a-long-random-passphrase"

# Signs the session cookie (HMAC-SHA256). MUST be long and random — changing it
# invalidates every existing session (which is how you force a logout).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="64-hex-chars-from-the-command-above"

# ---- Images (Cloudinary) ---------------------------------------------------
# Cloudinary → Dashboard → API Keys.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-api-secret"
# Folder all dashboard uploads land in.
CLOUDINARY_FOLDER="davnoot/blog"

# ---- Booking form email (Gmail SMTP) ---------------------------------------
# Sends lead notifications over Gmail / Google Workspace using an App Password.
# The account needs 2-Step Verification ON, then create an App Password at
# https://myaccount.google.com/apppasswords . GMAIL_USER is also the From address.
GMAIL_USER="info@davnoot.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
LEAD_TO="info@davnoot.com"

# ---- Booking form anti-spam (Cloudflare Turnstile) -------------------------
# OPTIONAL, and the strongest layer available. Everything else (the classifier in
# lib/spam.js, the rate limits, the honeypot, the browser stamp) works without it.
#
# Turnstile is free, needs no Cloudflare DNS, and does not require moving the
# domain: dash.cloudflare.com -> Turnstile -> Add widget, hostname www.davnoot.com
# (add davnoot.com and localhost too), widget mode "Managed".
#
# Setting BOTH keys switches it on with no code change and no redeploy of the
# marketing pages: script.js reads the site key from /api/form-config and injects
# the widget, and api/book-call.js starts REQUIRING a valid token. Setting only
# one does nothing useful — the secret is what enforces, the site key is what
# renders, so add them together.
#
# The site key is public (it ships in the widget). The secret key never leaves
# the server.
TURNSTILE_SITE_KEY="0x4AAAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAAA..."
